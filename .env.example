# Auto.dev API (server-side only)
AUTODEV_API_KEY=your_autodev_api_key_here

# Car Images API (used only if Auto.dev has no listing photo)
CAR_IMAGES_API_KEY=your_car_images_api_key_here

# Resend for lead emails
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL=deals@yourdomain.com

# PostHog (optional)
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://app.posthog.com

# Feature flags
VITE_USE_REAL_API=false

# Later: Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Supabase service role key. Server only. Never the anon key, never VITE_.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_service_role_key

# Webhook secret (for verifying incoming events). Leave unset to reject all webhooks.
WEBHOOK_SECRET=your_webhook_secret_here
